# RRQPE é publicado pela NOAA como NetCDF. Para exibir a camada no Leaflet,
# configure no Netlify um serviço que converta o produto para tiles XYZ HTTPS.
# O valor precisa conter literalmente {z}, {x} e {y}.
RRQPE_TILES_URL=https://seu-servico-de-tiles.example/rrqpe/{z}/{x}/{y}.png

# GOES/Nuvens: opcional. O app usa por padrão o serviço público NOAA/NNVL abaixo.
# Defina esta variável somente se quiser substituir a fonte padrão por outro
# serviço HTTPS que publique imagens em tiles XYZ compatíveis com Leaflet.
VITE_GOES_CLOUD_TILES_URL=
# ─── Backend (Express + PostgreSQL nativo do Replit) ─────────────────────────
#
# DATABASE_URL  → fornecido automaticamente pelo Replit quando o banco PostgreSQL
#                 nativo está provisionado (não defina manualmente em dev).
#
# ─── Web Push (notificações de SOS para agentes com app fechado) ─────────────
#
# Gere uma vez com:  npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY   → chave pública (base64-url) usada pelo navegador para
#                      assinar a inscrição push.
# VAPID_PRIVATE_KEY  → chave privada — NUNCA exponha no front-end. Só é usada
#                      pelo servidor (server/index.js) para enviar Web Push.
# VAPID_SUBJECT      → contato no formato `mailto:seu@email` ou URL.
#
# Sem essas três variáveis o app continua funcionando, mas o disparo de Web
# Push para outros agentes (rota POST /api/send-sos-push) ficará desativado.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:defesacivilob@gmail.com

# ─── NASA FIRMS (focos NRT: VIIRS, MODIS Terra/Aqua) ─────────────────────────
#
# Gere uma chave gratuita no portal NASA FIRMS:
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# ─── Google Earth Engine (GOES-19 ABI + MODIS/VIIRS em camadas) ──────────────
#
# O projeto pode ser informado aqui ou usa o projeto padrão configurado no app.
EARTH_ENGINE_PROJECT=studio-6342191983-7ea1e
EARTH_ENGINE_ENABLED=true
EARTH_ENGINE_SERVICE_ACCOUNT_JSON=

# CT_MERG_FIRE é uma coleção complementar específica. Informe o asset/coleção
# Earth Engine somente se sua equipe já tiver esse produto publicado.
EARTH_ENGINE_CT_MERG_FIRE_COLLECTION=
EARTH_ENGINE_CT_MERG_FIRE_BAND=FireMask
EARTH_ENGINE_CT_MERG_FIRE_MASK_TYPE=firemask
EARTH_ENGINE_CT_MERG_FIRE_THRESHOLD=7
EARTH_ENGINE_CT_MERG_FIRE_SCALE=2000
EARTH_ENGINE_CT_MERG_FIRE_DAYS=3
